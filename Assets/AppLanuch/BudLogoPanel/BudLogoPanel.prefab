  m_Text: "\u6839\u636E\u56FD\u5BB6\u65B0\u95FB\u51FA\u7248\u7F72\u300A\u5173\u4E8E\u9632\u6B62\u672A\u6210\u5E74\u4EBA\u6C89\u8FF7\u7F51\u7EDC\u6E38\u620F\u7684\u901A\u77E5\u300B\u3001\n\u300A\u5173\u4E8E\u8FDB\u4E00\u6B65\u4E25\u683C\u7BA1\u7406\u5207\u5B9E\u9632\u6B62\u672A\u6210\u5E74\u4EBA\u6C89\u8FF7\u7F51\u7EDC\u6E38\u620F\u7684\u901A\u77E5\u300B\uFF0C\n\u6240\u6709\u7F51\u7EDC\u6E38\u620F\u7528\u6237\u5747\u9700\u8981\u4F7F\u7528\u6709\u6548\u8EAB\u4EFD\u4FE1\u606F\u5B8C\u6210\u8D26\u53F7\u5B9E\u540D\u6CE8\u518C\u540E\u65B9\u53EF\u8FDB\u5165\u6E38\u620F\uFF0C\u8BA4\u8BC1\u4E3A\u672A\u6210\u5E74\u7684\u73A9\u5BB6\u5C06\u53D7\u5230\u9632\u6C89\u8FF7\u529F\u80FD\u9650\u5236\u3002\n\u7CA4\u7F51\u6587\u30102021\u30114135-618\u53F7\uFF0C\u7F51\u51FA\u8BC1\uFF08\u7CA4\uFF09\u5B57\u7B2C005\u53F7
    \u8457\u4F5C\u6743\u4EBA\uFF1A\u6DF1\u5733\u96F6\u70B9\u4E00\u5A31\u4E50\u79D1\u6280\u6709\u9650\u516C\u53F8
    \n\u51FA\u7248\u5355\u4F4D\uFF1A\u5E7F\u4E1C\u6D77\u71D5\u7535\u5B50\u97F3\u50CF\u51FA\u7248\u793E\u6709\u9650\u516C\u53F8
    \u8FD0\u8425\u5355\u4F4D\uFF1A\u6DF1\u5733\u96F6\u70B9\u4E00\u5A31\u4E50\u79D1\u6280\u6709\u9650\u516C\u53F8\n\u56FD\u65B0\u51FA\u5BA1\u30142024\u3015796\u53F7
    \u51FA\u7248\u7269\u53F7\uFF1AISBN 978-7-498-13394-6"
